PORT=3001
FRONTEND_URL=http://localhost:3000

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=demo-messages
KAFKA_CLIENT_ID=full-node-backend
KAFKA_GROUP_ID=full-node-consumer-group

# Partition demo (3 partitions, round-robin)
KAFKA_PARTITION_TOPIC=demo-partitions
KAFKA_PARTITION_COUNT=3
KAFKA_PARTITION_GROUP_ID=full-node-partition-consumer-group

# Key & ordering demo (message key = user_id)
KAFKA_KEY_TOPIC=demo-key-order
KAFKA_KEY_PARTITION_COUNT=3
KAFKA_KEY_GROUP_ID=full-node-key-order-consumer-group

# Manual commit demo (NestJS consumer: autoCommit=false)
KAFKA_COMMIT_TOPIC=demo-manual-commit
KAFKA_COMMIT_PARTITION_COUNT=1
KAFKA_CONSUMER_FROM_BEGINNING=true
# KAFKA_GROUP_ID=full-node-manual-commit-group

# Kafka UI: http://localhost:8080 (sau khi chạy npm run kafka:up)
